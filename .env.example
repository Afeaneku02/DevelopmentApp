# Better You - apps/api local environment
#
# Copy this file to `.env` in the repo root and adjust as needed:
#   cp .env.example .env
#
# apps/api loads it automatically on `npm run dev:api` / `npm run start -w apps/api`
# via Node's native `--env-file-if-exists` flag - no dotenv dependency, and startup
# doesn't fail if `.env` is missing (every value below has a working default).
# See RUNNING.md for the full local setup guide.

# Port the API server listens on locally. Ignored if PORT is also set (cloud
# hosts like Render inject their own PORT and it always wins - see
# docs/environments.md) - PORT deliberately isn't set here since it has no
# meaning for local dev.
API_PORT=4000

# Origin allowed to call the API via CORS. Must match wherever apps/web is
# actually running (its dev server defaults to http://localhost:5173).
API_CORS_ORIGIN=http://localhost:5173

# Directory where durable JSON data files (accounts, goals, check-ins, etc.)
# are read from and written to (ADR 0016). Relative paths resolve against
# apps/api's working directory, so the default below resolves to
# `Apps/api/data/` - already gitignored, since it holds real local credentials
# and user data once you sign up. Use `npm run reset-data` to clear it out.
DATA_DIR=./data

# Legacy dev-only stub user id (packages/config's getStubUserId()). Not used
# by the running apps/api or apps/web app - real Auth replaced it. Only
# tests/integration/goals.integration.test.ts still exercises it directly.
# Safe to ignore unless you're working on that specific test.
DEV_USER_ID=dev-user-local

# Optional local integration with the separate DevelopmentApp_AI_Models
# project - NOT a production dependency, and shared by two independent
# integrations that both leave Better You unchanged when unset:
#   - Roadmap generation (ADR 0024): PlaceholderRoadmapGenerator generates
#     every roadmap, no network call is ever made, unless AI_MODELS_BASE_URL
#     is set, in which case HttpRoadmapGenerator calls the real
#     POST /roadmaps/generate instead.
#   - Mentor feedback (ADR 0026): UnavailableMentorFeedbackClient answers
#     every GET /api/v1/mentor-feedback with status:"unavailable" and makes
#     no network call, unless AI_MODELS_BASE_URL is set, in which case
#     HttpMentorFeedbackClient calls the real
#     GET /users/{user_id}/mentor-feedback instead. Unlike roadmap
#     generation, a failure or malformed response here degrades to
#     status:"unavailable" too - it is never surfaced as an app error.
# Only set AI_MODELS_BASE_URL if you have that project running locally -
# it should remain a localhost/internal alpha service until it has real
# auth, so don't point this at anything else.
#
# To check the roadmap round-trip end to end: start that project's API
# (e.g. `python tools/serve_api.py --db alpha.sqlite3 --init-db --port 8100`),
# then run `npm run verify:ai-roadmap` from this repo. It defaults to
# http://127.0.0.1:8100, confirms a real POST /roadmaps/generate happened,
# that the AI response carried only RoadmapDraft fields, and that Better You
# still assigned every id/status/userId/goalId/timestamp itself.
# AI_MODELS_BASE_URL=http://127.0.0.1:8100
# AI_MODELS_SERVICE_TOKEN=
