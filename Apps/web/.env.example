# Better You - apps/web local environment
#
# Copy this file to `.env` in this directory (Apps/web/.env) and adjust as needed:
#   cp .env.example .env
#
# Vite loads it automatically on `npm run dev:web` - only variables prefixed
# `VITE_` are exposed to browser code (Vite's own convention, see
# src/api/config.ts). See RUNNING.md for the full local setup guide.

# Base URL the browser app calls apps/api on. Must match API_PORT/wherever
# apps/api is actually running.
VITE_API_BASE_URL=http://localhost:4000
