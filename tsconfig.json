{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "baseUrl": ".",
    "paths": {
      "@better-you/contracts": ["packages/contracts/src/index.ts"],
      "@better-you/contracts/*": ["packages/contracts/src/*"],
      "@better-you/config": ["packages/config/src/index.ts"],
      "@better-you/config/*": ["packages/config/src/*"],
      "@better-you/goals": ["services/goals/src/index.ts"],
      "@better-you/goals/*": ["services/goals/src/*"]
    }
  },
  "include": ["packages", "services", "tests"]
}
